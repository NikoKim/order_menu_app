# systemd EnvironmentFile syntax, not a shell script. No "export" prefix.
# Copy to backend/config/navy.env on the server and restrict it to root (0600).
NAVY_DB_HOST=127.0.0.1
NAVY_DB_PORT=3306
NAVY_DB_NAME=navy
NAVY_DB_USER=navy_admin
NAVY_DB_PASSWORD="REPLACE_WITH_DATABASE_PASSWORD"
NAVY_MAIL_USER=nju_zsj030702@163.com
NAVY_MAIL_SENDER_NAME="海战棋"
NAVY_MAIL_PASSWORD="REPLACE_WITH_SMTP_AUTHORIZATION_CODE"
# Persistent uploaded avatars; separate from frontend/assets build output.
NAVY_AVATAR_DIRECTORY=/www/wwwroot/navy/assets
# Exact public origin, without a trailing slash or path.
NAVY_FRONTEND_ORIGIN=https://navy.example.com
